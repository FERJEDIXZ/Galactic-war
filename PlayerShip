    public int RobarEscudo(int cantidadArobar)
    {
        int escudoRobado = Mathf.Min(escudoActual, cantidadArobar);
        
        if (escudoRobado > 0)
        {
            escudoActual -= escudoRobado;
            
            if (configuracionActiva == 1)
            {
                escudoActualConfig1 = escudoActual;
            }
            else if (configuracionActiva == 2)
            {
                escudoActualConfig2 = escudoActual;
            }
            
            ActualizarBarrasUI();
        }
        
        return escudoRobado;
    }

    public void AgregarEscudoRobado(int cantidad)
    {
        if (cantidad <= 0) return;
        
        escudoActual = Mathf.Min(escudoMax, escudoActual + cantidad);
        
        if (configuracionActiva == 1)
        {
            escudoActualConfig1 = escudoActual;
        }
        else if (configuracionActiva == 2)
        {
            escudoActualConfig2 = escudoActual;
        }
        
        ActualizarBarrasUI();
    }

