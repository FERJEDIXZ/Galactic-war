    }

    public void SetBonusEscudo(int totalEscudoEquipado)
    {
        SetBonusEscudoParaConfiguracion(totalEscudoEquipado, 50, configuracionActiva);
    }

    public void SetBonusEscudoParaConfiguracion(int totalEscudoEquipado, int porcentajeAbsorcionPromedio, int numeroConfig)
    {
        if (!isServer)
        {
            CmdSetBonusEscudoParaConfiguracion(totalEscudoEquipado, porcentajeAbsorcionPromedio, numeroConfig);
            return;
        }

        bonusEscudo = totalEscudoEquipado;

        if (numeroConfig == 1)
        {
            int escudoMaxAnterior = escudoMaxConfig1;
            escudoMaxConfig1 = Mathf.Max(0, totalEscudoEquipado);
            
            if (escudoMaxAnterior == 0 && escudoMaxConfig1 > 0)
            {
                escudoActualConfig1 = escudoMaxConfig1;
            }
            else
            {
                escudoActualConfig1 = Mathf.Clamp(escudoActualConfig1, 0, escudoMaxConfig1);
            }
            
            porcentajeAbsorcionConfig1 = Mathf.Clamp(porcentajeAbsorcionPromedio, 0, 100);
            
            if (configuracionActiva == 1)
            {
                escudoMax = escudoMaxConfig1;
                escudoActual = escudoActualConfig1;
                porcentajeAbsorcion = porcentajeAbsorcionConfig1;
                ActualizarBarrasUI();
            }
        }
        else
        {
            int escudoMaxAnterior = escudoMaxConfig2;
            escudoMaxConfig2 = Mathf.Max(0, totalEscudoEquipado);
            
            if (escudoMaxAnterior == 0 && escudoMaxConfig2 > 0)
            {
                escudoActualConfig2 = escudoMaxConfig2;
            }
            else
            {
                escudoActualConfig2 = Mathf.Clamp(escudoActualConfig2, 0, escudoMaxConfig2);
            }
            
            porcentajeAbsorcionConfig2 = Mathf.Clamp(porcentajeAbsorcionPromedio, 0, 100);
            
            if (configuracionActiva == 2)
            {
                escudoMax = escudoMaxConfig2;
                escudoActual = escudoActualConfig2;
                porcentajeAbsorcion = porcentajeAbsorcionConfig2;
                ActualizarBarrasUI();
            }
        }
    }

    [Command]
    void CmdSetBonusEscudoParaConfiguracion(int totalEscudoEquipado, int porcentajeAbsorcionPromedio, int numeroConfig)
    {
        SetBonusEscudoParaConfiguracion(totalEscudoEquipado, porcentajeAbsorcionPromedio, numeroConfig);
    }

    void RegenerarEscudo(float deltaTime)
    {
        if (escudoMax <= 0) return;
        if (escudoActual >= escudoMax) return;
        if (porcentajeRegenEscudoPorSegundo <= 0f) return;

        if (Time.time - tiempoUltimoDañoEscudo < tiempoEsperaRegenEscudo)
            return;

        float regenPorSegundo = escudoMax * (porcentajeRegenEscudoPorSegundo / 100f);
        float regenEsteFrame = regenPorSegundo * deltaTime;

        escudoRegenAcumulado += regenEsteFrame;

        if (escudoRegenAcumulado >= 1f)
        {
            int puntos = Mathf.FloorToInt(escudoRegenAcumulado);
            escudoRegenAcumulado -= puntos;

            escudoActual = Mathf.Min(escudoMax, escudoActual + puntos);
            
            if (configuracionActiva == 1)
            {
                escudoActualConfig1 = escudoActual;
            }
            else if (configuracionActiva == 2)
            {
                escudoActualConfig2 = escudoActual;
            }
            
            ActualizarBarrasUI();
        }
    }

    void RegenerarVida(float deltaTime)
    {
        if (vidaMax <= 0) return;
        if (vidaActual >= vidaMax)
        {
            DesactivarRepairBot();
            return;
        }
        if (porcentajeRegenVidaPorSegundo <= 0f)
        {
            DesactivarRepairBot();
            return;
        }

        if (Time.time - tiempoUltimoDañoVida < tiempoEsperaRegenVida)
        {
            DesactivarRepairBot();
            return;
        }

        ActivarRepairBot();

        float regenPorSegundo = vidaMax * (porcentajeRegenVidaPorSegundo / 100f);
        float regenEsteFrame = regenPorSegundo * deltaTime;

        vidaRegenAcumulado += regenEsteFrame;

        if (vidaRegenAcumulado >= 1f)
        {
            int puntos = Mathf.FloorToInt(vidaRegenAcumulado);
            vidaRegenAcumulado -= puntos;

            vidaActual = Mathf.Min(vidaMax, vidaActual + puntos);
            ActualizarBarrasUI();
        }
    }

    public void SetBonusDaño(int bonus)
    {
        if (!isServer)
        {
            CmdSetBonusDaño(bonus);
            return;
        }
        
        bonusDaño = bonus;
    }

    [Command]
    void CmdSetBonusDaño(int bonus)
    {
        SetBonusDaño(bonus);
    }

    void RecalcularVelocidadTotal()
    {
        velocidadActual = velocidadBase + bonusVelocidad;
