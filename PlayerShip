    /// <summary>
    /// Fuerza a todos los atacantes a desmarcarse de esta nave
    /// </summary>
    private void DesmarcarmeDeAtacantes()
    {
        // Buscar TODOS los PlayerShips en la escena
        PlayerShip[] todosLosJugadores = FindObjectsOfType<PlayerShip>();
        
        foreach (PlayerShip otroJugador in todosLosJugadores)
        {
            // Si ese jugador me tiene como objetivo, forzarlo a desmarcarme
            if (otroJugador != this && otroJugador.GetCurrentAttackTarget() == transform)
            {
                Debug.Log($"[PlayerShip] Forzando a {otroJugador.name} a desmarcarme (SERVER)");
                
                // FORZAR desde el servidor directamente actualizando la SyncVar
                otroJugador.ForzarDesmarcadoDesdeServidor();
            }
        }
    }

    /// <summary>
    /// Cambia la nave actual del jugador (solo para jugador local)
    /// </summary>
    public void CambiarNave(NaveData nuevaNaveData)
    {
        Debug.Log($"[PlayerShip] 🔄 CambiarNave LLAMADO - Nave: {nuevaNaveData?.nombreNave}, isLocalPlayer: {isLocalPlayer}, isServer: {isServer}, netId: {netId}");
        
        if (!isLocalPlayer)
        {
            Debug.LogWarning("[PlayerShip] Solo el jugador local puede cambiar de nave");
            return;
        }

        if (nuevaNaveData == null)
        {
            Debug.LogError("[PlayerShip] NaveData es null");
            return;
        }

        if (naveRegistry == null)
        {
            Debug.LogError("[PlayerShip] NaveRegistry es null");
            return;
        }

        // Obtener el índice de la nueva nave
        int nuevoIndice = naveRegistry.GetIndiceDeNave(nuevaNaveData);
        if (nuevoIndice < 0)
        {
            Debug.LogError($"[PlayerShip] No se encontró la nave '{nuevaNaveData.nombreNave}' en el registro");
            return;
        }

        Debug.Log($"[PlayerShip] Cambiando nave a: {nuevaNaveData.nombreNave} (índice {nuevoIndice})");

        // Actualizar el NaveData local
        naveData = nuevaNaveData;

        // Enviar el nuevo índice al servidor
        Debug.Log($"[PlayerShip] ⬆️ Enviando CmdCambiarNave({nuevoIndice}) al servidor...");
        CmdCambiarNave(nuevoIndice);

        // Actualizar el visual localmente
        Debug.Log($"[PlayerShip] 🎨 Actualizando visual localmente...");
        ActualizarVisualDeNave(nuevaNaveData);

        // Actualizar stats localmente
        ActualizarStatsDeNave(nuevaNaveData);

        // 🔧 NOTIFICAR AL EQUIPMENTPANEL PARA QUE ACTUALICE LOS SLOTS
        if (EquipmentPanel.Instance != null)
        {
            EquipmentPanel.Instance.RefrescarPorCambioDeNave();
            Debug.Log("[PlayerShip] EquipmentPanel notificado del cambio de nave");
        }
        
        // 📋 NOTIFICAR AL MENUUI PARA QUE ACTUALICE LA INFO DE LA NAVE
        MenuUI menuUI = FindObjectOfType<MenuUI>();
        if (menuUI != null)
        {
            menuUI.RefrescarInfoNave();
            Debug.Log("[PlayerShip] MenuUI notificado del cambio de nave");
        }
        
        Debug.Log($"[PlayerShip] ✅ CambiarNave COMPLETADO localmente");
    }

    [Command]
    void CmdCambiarNave(int nuevoIndice)
    {
        Debug.Log($"[PlayerShip SERVER] 📥 CmdCambiarNave recibido: índice {nuevoIndice}, connectionToClient: {connectionToClient.connectionId}, netId: {netId}");

        // Actualizar el índice sincronizado (esto dispara OnNaveIndexChanged en todos los clientes)
        Debug.Log($"[PlayerShip SERVER] ⚡ Actualizando naveIndex: {naveIndex} → {nuevoIndice} (esto disparará OnNaveIndexChanged en todos)");
        naveIndex = nuevoIndice;

        // Obtener la nueva NaveData
        if (naveRegistry != null)
        {
            NaveData nuevaData = naveRegistry.GetNavePorIndice(nuevoIndice);
            if (nuevaData != null)
            {
                // Actualizar datos visuales sincronizados
                visualRotation = nuevaData.rotacionLocal;
                visualScale = nuevaData.escalaLocal;
                visualPosition = nuevaData.posicionLocal;
                visualDataSynced = true;

                // Actualizar stats en el servidor
                velocidadBase = nuevaData.velocidadBase;
                int nuevoVidaMax = Mathf.RoundToInt(nuevaData.vidaMax);
                
                // Ajustar vida actual proporcionalmente
                float porcentajeVida = vidaMax > 0 ? (float)vidaActual / vidaMax : 1f;
                vidaMax = nuevoVidaMax;
                vidaActual = Mathf.RoundToInt(nuevoVidaMax * porcentajeVida);
                vidaActual = Mathf.Clamp(vidaActual, 1, vidaMax);

                RecalcularVelocidadTotal();
                ActualizarBarrasUI();

                Debug.Log($"[PlayerShip SERVER] ✅ Nave cambiada a: {nuevaData.nombreNave}");
            }
            else
            {
                Debug.LogError($"[PlayerShip SERVER] No se pudo obtener NaveData para índice {nuevoIndice}");
            }
        }
        else
        {
            Debug.LogError("[PlayerShip SERVER] naveRegistry es null");
        }
    }

    /// <summary>
    /// Actualiza el visual de la nave (destruye el anterior y crea el nuevo)
    /// </summary>
    void ActualizarVisualDeNave(NaveData nuevaData)
    {
        Debug.Log($"[PlayerShip] 🔧 ActualizarVisualDeNave INICIANDO - Nave: {nuevaData?.nombreNave}, isLocalPlayer: {isLocalPlayer}, isServer: {isServer}, netId: {netId}");
        
        if (nuevaData == null || nuevaData.prefabNave == null)
        {
            Debug.LogError("[PlayerShip] No se puede actualizar visual: NaveData o prefab null");
            return;
        }

        // 🧹 PRIMERO: Limpiar FirePoints viejos explícitamente
        if (firePoints != null)
        {
            for (int i = 0; i < firePoints.Length; i++)
            {
                if (firePoints[i] != null && firePoints[i].gameObject != null)
                {
                    Destroy(firePoints[i].gameObject);
                }
            }
            firePoints = null;
            Debug.Log($"[PlayerShip] FirePoints viejos destruidos (netId: {netId})");
        }

        // Destruir el visual anterior
        if (naveVisual != null)
        {
            Destroy(naveVisual);
            naveVisual = null;
        }

        // Crear el nuevo visual
        naveVisual = Instantiate(nuevaData.prefabNave, transform);
        naveVisual.transform.localPosition = nuevaData.posicionLocal;
        naveVisual.transform.localRotation = Quaternion.Euler(nuevaData.rotacionLocal);
        naveVisual.transform.localScale = nuevaData.escalaLocal;

        naveVisualInstanciada = true;

        // Recrear los fire points INMEDIATAMENTE en el nuevo visual
        CrearFirePointsDesdeNaveData(nuevaData);
        
        Debug.Log($"[PlayerShip] FirePoints creados: {(firePoints != null ? firePoints.Length : 0)} (netId: {netId})");

        // 🔫 NOTIFICAR INMEDIATAMENTE (sin delay)
        if (firePoints != null && firePoints.Length > 0)
        {
            // Verificar que los FirePoints sean válidos AHORA
            int validCount = 0;
            for (int i = 0; i < firePoints.Length; i++)
            {
                if (firePoints[i] != null)
                {
                    validCount++;
                    Debug.Log($"[PlayerShip] ✓ FirePoint[{i}] creado: {firePoints[i].name} en posición {firePoints[i].position} (netId: {netId})");
                }
                else
                {
                    Debug.LogError($"[PlayerShip] ✗ FirePoint[{i}] es NULL al crear! (netId: {netId})");
                }
            }
            
            if (validCount > 0)
            {
                PlayerShoot playerShoot = GetComponent<PlayerShoot>();
                if (playerShoot != null)
                {
                    playerShoot.ActualizarFirePoints(firePoints);
                    Debug.Log($"[PlayerShip] ✅ PlayerShoot notificado INMEDIATAMENTE de {validCount} FirePoints válidos (netId: {netId})");
                }
                else
                {
                    Debug.LogError($"[PlayerShip] No se encontró PlayerShoot component! (netId: {netId})");
                }
            }
            else
            {
                Debug.LogError($"[PlayerShip] Todos los FirePoints son NULL después de crear! (netId: {netId})");
            }
        }
        else
        {
            Debug.LogError($"[PlayerShip] No se crearon FirePoints! (netId: {netId})");
        }

        Debug.Log($"[PlayerShip] ✅ Visual actualizado a: {nuevaData.nombreNave} (netId: {netId})");
    }

    /// <summary>
    /// Actualiza las estadísticas de la nave
    /// </summary>
    void ActualizarStatsDeNave(NaveData nuevaData)
    {
        if (nuevaData == null) return;

        // Actualizar velocidad
        velocidadBase = nuevaData.velocidadBase;
        RecalcularVelocidadTotal();

        // 🆕 OPCIÓN 1: Dar vida completa al cambiar de nave (gameplay justo)
        vidaMax = Mathf.RoundToInt(nuevaData.vidaMax);
        vidaActual = vidaMax; // ✅ Vida completa
        
        // 🆕 OPCIÓN 2 (alternativa comentada): Mantener % de vida
        // Descomentar si prefieres mantener el porcentaje de vida:
        /*
        int nuevoVidaMax = Mathf.RoundToInt(nuevaData.vidaMax);
        float porcentajeVida = vidaMax > 0 ? (float)vidaActual / vidaMax : 1f;
        vidaMax = nuevoVidaMax;
        vidaActual = Mathf.RoundToInt(nuevoVidaMax * porcentajeVida);
        vidaActual = Mathf.Clamp(vidaActual, 1, vidaMax);
        */

        // Actualizar UI
        ActualizarBarrasUI();

        Debug.Log($"[PlayerShip] Stats actualizados - Vida: {vidaActual}/{vidaMax}, Velocidad: {velocidadActual}");
    }

    /// <summary>
    /// Fuerza el desmarcado desde el servidor (solo llamar en servidor)
    /// </summary>
    private void ForzarDesmarcadoDesdeServidor()
    {
        if (!isServer)
        {
            Debug.LogWarning("[PlayerShip] ForzarDesmarcadoDesdeServidor debe llamarse solo en servidor");
            return;
        }

        // Actualizar directamente la SyncVar desde el servidor
        currentTargetNetId = 0;
        
        // 🔫 DETENER EL DISPARO EN TODOS LOS CLIENTES
        RpcForzarDetenerDisparo();
        
        Debug.Log($"[PlayerShip] {name} fue desmarcado por PEM y disparo detenido");
    }
    
    [ClientRpc]
    void RpcForzarDetenerDisparo()
    {
        // Ejecutar en todos los clientes (especialmente en el que está disparando)
        PlayerShoot playerShoot = GetComponent<PlayerShoot>();
        if (playerShoot != null)
        {
            // Llamar directamente al método privado con parámetro
            playerShoot.DetenerDisparoYLimpiarObjetivo();
            
            Debug.Log($"[PlayerShip] Disparo detenido por PEM en cliente de {name}");
        }
    }
