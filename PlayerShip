    public void CambiarConfiguracion(int numeroConfig)
    {
        if (numeroConfig != 1 && numeroConfig != 2)
        {
            Debug.LogError($"[PlayerShip] Configuración inválida: {numeroConfig}");
            return;
        }

        if (configuracionActiva == numeroConfig)
        {
            return;
        }

        if (!isServer)
        {
            CmdCambiarConfiguracion(numeroConfig);
            return;
        }

        GuardarEstadoConfiguracion();
        configuracionActiva = numeroConfig;
        CargarConfiguracion(numeroConfig);
    }

