    void Awake()
    {
        if (!Debug.isDebugBuild && !enableDebugLogs)
            Debug.unityLogger.logEnabled = false;
        
        // Inicializar el registro de naves
        if (naveRegistry != null)
        {
            naveRegistry.Inicializar();
        }
    }

    // =====================================================
    // INICIALIZACIÓN DE RED
    // =====================================================
    
    public override void OnStartServer()
    {
        base.OnStartServer();
        
        if (naveData != null && naveRegistry != null)
        {
            // Sincronizar el índice de la nave
            naveIndex = naveRegistry.GetIndiceDeNave(naveData);
            
            // Sincronizar datos visuales
            visualRotation = naveData.rotacionLocal;
            visualScale = naveData.escalaLocal;
            visualPosition = naveData.posicionLocal;
            visualDataSynced = true;
        }
    }

    public override void OnStartClient()
    {
        base.OnStartClient();
        
        // Esperar a que las SyncVars lleguen antes de instanciar
        if (visualDataSynced || isLocalPlayer)
        {
            InstanciarNaveVisual();
        }
        else
        {
            // Esperar un poco más para jugadores remotos
            Invoke(nameof(InstanciarNaveVisual), 0.2f);
        }
    }

    public override void OnStartLocalPlayer()
    {
        base.OnStartLocalPlayer();
        
        // Enviar el índice de nave al servidor
        if (naveRegistry != null && naveData != null)
        {
            int index = naveRegistry.GetIndiceDeNave(naveData);
            CmdSetNaveIndex(index);
        }
    }

    [Command]
    void CmdSetNaveIndex(int index)
    {
        // El servidor actualiza el naveIndex, que se sincroniza a todos los clientes
        naveIndex = index;
        
        // También actualizar los datos visuales basados en la nave
        if (naveRegistry != null)
        {
            NaveData data = naveRegistry.GetNavePorIndice(index);
            if (data != null)
            {
                visualRotation = data.rotacionLocal;
                visualScale = data.escalaLocal;
                visualPosition = data.posicionLocal;
                visualDataSynced = true;
            }
        }
    }

    // =====================================================
    // CICLO DE VIDA
    // =====================================================

    void Start()
    {
        rb = GetComponent<Rigidbody>();
        rb.interpolation = RigidbodyInterpolation.Interpolate;

        AplicarDatosDeNave();
        BuscarBarrasUI();

        if (isLocalPlayer)
        {
            LocalPlayer = this;
            
            if (healthBarRoot != null) healthBarRoot.gameObject.SetActive(true);
            if (shieldBarRoot != null) shieldBarRoot.gameObject.SetActive(true);
            
            minimapCamera = FindObjectOfType<MinimapCamera>();
            targetRotation = transform.rotation;
            
            ConfigurarCamara();
        }
        else
        {
            if (healthBarRoot != null) healthBarRoot.gameObject.SetActive(false);
            if (shieldBarRoot != null) shieldBarRoot.gameObject.SetActive(false);
        }

        ActualizarBarrasUI();
    }

    void Update()
    {
        if (isLocalPlayer)
        {
            bool enMovimientoAutomatico = minimapCamera != null && minimapCamera.IsAutoMoving();
            
            if (!enMovimientoAutomatico)
            {
                float h = SimpleJoystick.Horizontal;
                float v = SimpleJoystick.Vertical;
                inputDirection = new Vector3(h, 0, v);

                if (!bloquearRotacionPorMovimiento && inputDirection.sqrMagnitude > 0.01f)
                {
                    targetRotation = Quaternion.LookRotation(inputDirection, Vector3.up);
                }
            }
            else
            {
                float h = SimpleJoystick.Horizontal;
                float v = SimpleJoystick.Vertical;
                
                if ((h * h + v * v) > 0.01f)
                {
                    minimapCamera.CancelClickToMove();
                    inputDirection = new Vector3(h, 0, v);
                }
                else
                {
                    inputDirection = minimapCamera.GetAutoMoveDirection();
                }

                if (!bloquearRotacionPorMovimiento && inputDirection.sqrMagnitude > 0.01f)
                {
                    targetRotation = Quaternion.LookRotation(inputDirection, Vector3.up);
                }
            }
        }

        if (isServer)
        {
            RegenerarEscudo(Time.deltaTime);
            RegenerarVida(Time.deltaTime);
            
            // 🛡️ Verificar si la invulnerabilidad terminó
            if (esInvulnerable && Time.time >= tiempoFinInvulnerabilidad)
            {
                esInvulnerable = false;
                Debug.Log($"[PlayerShip] {name} ya NO es invulnerable");
            }
            
            // 📡 Verificar si el PEM (no seleccionable) terminó
            if (esNoSeleccionable && Time.time >= tiempoFinNoSeleccionable)
            {
                esNoSeleccionable = false;
                Debug.Log($"[PlayerShip] {name} ya puede ser SELECCIONADO nuevamente");
            }
        }
    }

    void FixedUpdate()
    {
        if (!isLocalPlayer)
            return;

        rb.linearVelocity = inputDirection * velocidadActual;

        // ✅ UNIFICADO: Solo aquí se aplica la rotación para el jugador local
        if (bloquearRotacionPorMovimiento || inputDirection.sqrMagnitude > 0.01f)
        {
            transform.rotation = Quaternion.Slerp(
                transform.rotation,
                targetRotation,
                10f * Time.fixedDeltaTime
            );
        }
    }

    void LateUpdate()
    {
        // ✅ CORREGIDO: Rotación INSTANTÁNEA para jugadores remotos que atacan
        // Esto es puramente visual - la nave remota siempre apunta directamente al objetivo
        if (!isLocalPlayer && IsAttacking() && currentTargetTransform != null && bloquearRotacionPorMovimiento)
        {
            Vector3 dir = currentTargetTransform.position - transform.position;
            dir.y = 0f;

            if (dir.sqrMagnitude > 0.01f)
            {
                // ✅ CAMBIO: Rotación DIRECTA sin Slerp para que siempre apunte al objetivo
                Quaternion rotObjetivo = Quaternion.LookRotation(dir.normalized, Vector3.up);
                transform.rotation = rotObjetivo;
            }
        }
    }

    void OnDestroy()
    {
        if (LocalPlayer == this)
        {
            LocalPlayer = null;
        }
    }

    // =====================================================
    // SINCRONIZACIÓN DE NAVE VISUAL
    // =====================================================

    void OnNaveIndexChanged(int oldValue, int newValue)
    {
        naveIndex = newValue;
        
        Debug.Log($"[PlayerShip] OnNaveIndexChanged: {oldValue} → {newValue}, isLocalPlayer: {isLocalPlayer}, isServer: {isServer}, isClient: {isClient}, netId: {netId}");
        
        // ⚠️ Si es el jugador local, NO hacer nada aquí
        // El visual ya fue actualizado en CambiarNave() > ActualizarVisualDeNave()
        // Si actualizamos aquí, destruiremos los FirePoints que acabamos de crear
        if (isLocalPlayer)
        {
            Debug.Log($"[PlayerShip] ✅ Jugador local (netId: {netId}) - OnNaveIndexChanged IGNORADO (visual ya actualizado)");
            return;
        }
        
        Debug.Log($"[PlayerShip] Jugador remoto (netId: {netId}) - Actualizando visual por cambio de nave");
        
        // Solo para jugadores REMOTOS: actualizar su visual cuando vemos que cambió de nave
        if (naveVisualInstanciada && naveVisual != null)
        {
            Destroy(naveVisual);
            naveVisual = null;
            naveVisualInstanciada = false;
        }
        
        // Instanciar el nuevo visual
        InstanciarNaveVisual();
        
        // 🔫 NOTIFICAR A PLAYERSHOOT DE LOS NUEVOS FIREPOINTS
        StartCoroutine(NotificarFirePointsConDelay());
    }
    
    System.Collections.IEnumerator NotificarFirePointsConDelay()
    {
        yield return null; // Esperar un frame
        
        if (firePoints != null && firePoints.Length > 0)
        {
            PlayerShoot playerShoot = GetComponent<PlayerShoot>();
            if (playerShoot != null)
            {
                playerShoot.ActualizarFirePoints(firePoints);
                Debug.Log($"[PlayerShip] FirePoints actualizados en jugador remoto: {firePoints.Length} puntos");
            }
        }
    }

    void OnVisualDataSyncedChanged(bool oldValue, bool newValue)
    {
        visualDataSynced = newValue;
        
        // Si los datos están sincronizados y aún no hemos instanciado, hacerlo ahora
        if (newValue && !naveVisualInstanciada && !isLocalPlayer)
        {
            InstanciarNaveVisual();
        }
    }

    // =====================================================
    // INICIALIZACIÓN NAVE
    // =====================================================

    void AplicarDatosDeNave()
    {
        // Obtener NaveData correcto según si es local o remoto
        NaveData dataToUse = ObtenerNaveDataActual();
        
        if (dataToUse == null)
        {
            Debug.LogError("[PlayerShip] No hay NaveData disponible.");
            return;
        }

        velocidadBase = dataToUse.velocidadBase;
        vidaMax = Mathf.RoundToInt(dataToUse.vidaMax);

        if (vidaActual <= 0 || vidaActual > vidaMax)
            vidaActual = vidaMax;

        if (escudoMaxConfig1 < 0) escudoMaxConfig1 = 0;
        if (escudoActualConfig1 < 0) escudoActualConfig1 = 0;
        if (escudoMaxConfig2 < 0) escudoMaxConfig2 = 0;
        if (escudoActualConfig2 < 0) escudoActualConfig2 = 0;

        CargarConfiguracion(configuracionActiva);
        RecalcularVelocidadTotal();
        ActualizarBarrasUI();
    }

    NaveData ObtenerNaveDataActual()
    {
        // Si es el jugador local, usar el naveData asignado en el inspector
        if (isLocalPlayer)
        {
            return naveData;
        }
        
        // Para jugadores remotos, obtener del registro usando el índice sincronizado
        if (naveRegistry != null && naveIndex >= 0)
        {
            return naveRegistry.GetNavePorIndice(naveIndex);
        }
        
        // Fallback al naveData local
        return naveData;
    }

    void InstanciarNaveVisual()
    {
        if (naveVisualInstanciada)
        {
            return;
        }
        
        // Obtener el NaveData correcto
        NaveData dataToUse;
        
        if (isLocalPlayer)
        {
            // Jugador local: usar su propio naveData
            dataToUse = naveData;
        }
        else
        {
            // Jugador remoto: obtener del registro usando el índice sincronizado
            if (naveRegistry != null && naveIndex >= 0)
            {
                dataToUse = naveRegistry.GetNavePorIndice(naveIndex);
            }
            else if (NaveRegistry.Instance != null && naveIndex >= 0)
            {
                dataToUse = NaveRegistry.Instance.GetNavePorIndice(naveIndex);
            }
            else
            {
                Debug.LogWarning($"[PlayerShip] No se pudo obtener NaveData para jugador remoto. naveIndex={naveIndex}");
                return;
            }
        }
        
        if (dataToUse == null || dataToUse.prefabNave == null)
        {
            Debug.LogError("[PlayerShip] NaveData o prefabNave es null.");
            return;
        }

        naveVisual = Instantiate(dataToUse.prefabNave, transform);
        
        // Usar datos sincronizados para posición/rotación/escala si están disponibles
        if (visualDataSynced && !isLocalPlayer)
        {
            naveVisual.transform.localPosition = visualPosition;
            naveVisual.transform.localRotation = Quaternion.Euler(visualRotation);
            naveVisual.transform.localScale = visualScale;
        }
        else
        {
            naveVisual.transform.localPosition = dataToUse.posicionLocal;
            naveVisual.transform.localRotation = Quaternion.Euler(dataToUse.rotacionLocal);
            naveVisual.transform.localScale = dataToUse.escalaLocal;
        }

        naveVisualInstanciada = true;

        CrearFirePointsDesdeNaveData(dataToUse);
    }

    void CrearFirePointsDesdeNaveData(NaveData dataToUse)
    {
        if (dataToUse == null || dataToUse.firePointsOffsets == null || dataToUse.firePointsOffsets.Count == 0)
        {
            firePoints = null;
            return;
        }

        firePoints = new Transform[dataToUse.firePointsOffsets.Count];

        for (int i = 0; i < dataToUse.firePointsOffsets.Count; i++)
        {
            var offset = dataToUse.firePointsOffsets[i];
            if (offset == null) continue;

            GameObject go = new GameObject($"FirePoint_{i}");
            go.transform.SetParent(naveVisual.transform, false);
            go.transform.localPosition = offset.localPosition;
            go.transform.localRotation = Quaternion.Euler(offset.localRotation);

            firePoints[i] = go.transform;
        }
        
        Debug.Log($"[PlayerShip] ✓ FirePoints creados: {firePoints.Length} para {(isLocalPlayer ? "LOCAL" : "REMOTO")} - NaveIndex: {naveIndex}");
    }

    // =====================================================
    // BÚSQUEDA DE BARRAS EN EL PREFAB
    // =====================================================

    void BuscarBarrasUI()
    {
        if (!string.IsNullOrEmpty(healthBarPath))
        {
            Transform tHealth = transform.Find(healthBarPath);
            if (tHealth != null)
            {
                healthBarInstance = tHealth.GetComponentInChildren<Slider>();
                healthBarRoot = tHealth;
                tHealth.localPosition = healthBarLocalPosition;
                tHealth.localScale = healthBarLocalScale;
            }
        }

        if (!string.IsNullOrEmpty(shieldBarPath))
        {
            Transform tShield = transform.Find(shieldBarPath);
            if (tShield != null)
            {
                shieldBarInstance = tShield.GetComponentInChildren<Slider>();
                shieldBarRoot = tShield;
                tShield.localPosition = shieldBarLocalPosition;
                tShield.localScale = shieldBarLocalScale;
            }
        }

        if (healthBarInstance != null)
        {
            healthBarInstance.minValue = 0f;
            healthBarInstance.wholeNumbers = false;
        }

        if (shieldBarInstance != null)
        {
            shieldBarInstance.minValue = 0f;
            shieldBarInstance.wholeNumbers = false;
        }
    }

    void ConfigurarCamara()
    {
        Camera cam = Camera.main;
        if (cam == null) return;

        CameraFollow follow = cam.GetComponent<CameraFollow>();
        if (follow == null)
            follow = cam.gameObject.AddComponent<CameraFollow>();

        follow.target = transform;
    }

