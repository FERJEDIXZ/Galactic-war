    [ClientRpc]
    private void RpcSpawnBombaEnClientes(string bombDataName, Vector3 posicion, uint ownerNetId)
    {
        Debug.Log($"[PlayerShip] RpcSpawnBombaEnClientes en {(isServer ? "SERVIDOR" : "CLIENTE")} - Bomba: {bombDataName}");
        
        // Buscar el ExtraBombData por nombre
        ExtraBombData bombData = FindBombDataByName(bombDataName);
        
        if (bombData == null)
        {
            Debug.LogError($"[PlayerShip] No se encontró ExtraBombData con nombre '{bombDataName}'");
            return;
        }
        
        if (bombData.bombaPrefab == null)
        {
            Debug.LogError($"[PlayerShip] bombaPrefab es null para '{bombDataName}'");
            return;
        }
        
        // Buscar el owner transform
        Transform ownerTransform = null;
        if (ownerNetId != 0 && NetworkClient.spawned.TryGetValue(ownerNetId, out NetworkIdentity ownerIdentity))
        {
            ownerTransform = ownerIdentity.transform;
        }
        
        // Instanciar la bomba LOCALMENTE (sin NetworkServer.Spawn)
        GameObject bombaObj = Instantiate(bombData.bombaPrefab, posicion, Quaternion.identity);
        
        // Obtener el componente Bomb del prefab (debe tener el script actualizado)
        Bomb bomba = bombaObj.GetComponent<Bomb>();
        if (bomba == null)
        {
            Debug.LogError("[PlayerShip] El prefab de bomba no tiene componente Bomb!");
            Destroy(bombaObj);
            return;
        }
        
        bomba.Init(bombData, ownerTransform, ownerNetId);
        
        Debug.Log($"[PlayerShip] ✅ Bomba '{bombData.nombre}' instanciada localmente");
    }

    private ExtraBombData FindBombDataByName(string bombName)
    {
        // Buscar en ExtraUI
        ExtraUI extraUI = ExtraUI.Instance;
        if (extraUI != null && extraUI.extras != null)
        {
            foreach (var extra in extraUI.extras)
            {
                if (extra is ExtraBombData bombData && bombData.name == bombName)
                {
                    Debug.Log($"[PlayerShip] ✓ Bomba '{bombName}' encontrada en ExtraUI");
                    return bombData;
                }
            }
        }
        
        // Buscar en Resources
        ExtraBombData[] allBombs = Resources.LoadAll<ExtraBombData>("");
        foreach (var bomb in allBombs)
        {
            if (bomb.name == bombName)
            {
                Debug.Log($"[PlayerShip] ✓ Bomba '{bombName}' encontrada en Resources");
                return bomb;
            }
        }
        
        Debug.LogError($"[PlayerShip] ✗ No se encontró bomba con nombre '{bombName}' ni en ExtraUI ni en Resources");
        return null;
    }

