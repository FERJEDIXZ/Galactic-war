    private void GuardarEstadoConfiguracion()
    {
        if (!isServer)
        {
            CmdGuardarEstadoConfiguracion(configuracionActiva, escudoMax, escudoActual);
            return;
        }

        if (configuracionActiva == 1)
        {
            escudoMaxConfig1 = escudoMax;
            escudoActualConfig1 = escudoActual;
        }
        else
        {
            escudoMaxConfig2 = escudoMax;
            escudoActualConfig2 = escudoActual;
        }
    }

    [Command]
    void CmdGuardarEstadoConfiguracion(int configNum, int maxEscudo, int actualEscudo)
    {
        if (configNum == 1)
        {
            escudoMaxConfig1 = maxEscudo;
            escudoActualConfig1 = actualEscudo;
        }
        else if (configNum == 2)
        {
            escudoMaxConfig2 = maxEscudo;
            escudoActualConfig2 = actualEscudo;
        }
    }

    private void CargarConfiguracion(int numeroConfig)
    {
        if (numeroConfig == 1)
        {
            escudoMax = escudoMaxConfig1;
            escudoActual = escudoActualConfig1;
            porcentajeAbsorcion = porcentajeAbsorcionConfig1;
        }
        else
        {
            escudoMax = escudoMaxConfig2;
            escudoActual = escudoActualConfig2;
            porcentajeAbsorcion = porcentajeAbsorcionConfig2;
        }

        escudoActual = Mathf.Clamp(escudoActual, 0, escudoMax);
        ActualizarBarrasUI();
    }

