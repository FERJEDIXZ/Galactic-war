    public void RecibirDaño(int cantidad)
    {
        // 🛡️ Si es invulnerable, no recibe daño
        if (esInvulnerable)
        {
            Debug.Log($"[PlayerShip] {name} es invulnerable, daño bloqueado: {cantidad}");
            return;
        }

        int dañoTotal = cantidad;
        
        if (escudoActual > 0 && porcentajeAbsorcion > 0)
        {
            int dañoParaEscudo = Mathf.RoundToInt(cantidad * (porcentajeAbsorcion / 100f));
            int dañoParaVida = cantidad - dañoParaEscudo;
            
            int dañoAbsorbido = Mathf.Min(escudoActual, dañoParaEscudo);
            escudoActual -= dañoAbsorbido;
            
            int dañoNoAbsorbido = dañoParaEscudo - dañoAbsorbido;
            dañoParaVida += dañoNoAbsorbido;
            
            tiempoUltimoDañoEscudo = Time.time;
            
            if (configuracionActiva == 1)
            {
                escudoActualConfig1 = escudoActual;
            }
            else
            {
                escudoActualConfig2 = escudoActual;
            }
            
            if (dañoParaVida > 0)
            {
                vidaActual = Mathf.Max(0, vidaActual - dañoParaVida);
                tiempoUltimoDañoVida = Time.time;
            }
        }
        else
        {
            vidaActual = Mathf.Max(0, vidaActual - cantidad);
            tiempoUltimoDañoVida = Time.time;
            tiempoUltimoDañoEscudo = Time.time;
        }

        ActualizarBarrasUI();
        
        if (DamageTextManager.Instance != null)
        {
            DamageTextManager.Instance.ShowDamage(dañoTotal, transform.position, Color.red, netId);
        }
    }

